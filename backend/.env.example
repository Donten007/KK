# OPCAgentAI 后端环境变量模板。复制为 .env 后填写，禁止把 .env 提交版本库。

# ---- 应用 ----
APP_ENV=development                       # development | staging | production
APP_DEBUG=true
APP_URL=http://localhost:8000             # 本站基址（邮件链接、CORS 默认源之一）
FRONTEND_ORIGIN=http://localhost:5173     # 前端开发服务器（CORS 白名单，生产必须显式覆盖）

# ---- 数据库（应用连接角色必须非 superuser 且无 BYPASSRLS，见 scripts/bootstrap_dev_db.sql）----
DATABASE_URL=postgresql+asyncpg://opc_app:opc_app_dev@localhost:5432/opcagentai
# 迁移连接角色（DDL 需要建表/建策略权限，与应用角色分离）
DATABASE_MIGRATION_URL=postgresql+asyncpg://opc_migrate:opc_migrate_dev@localhost:5432/opcagentai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=15000

# ---- Redis（限流/缓存/SSE 事件总线；不可用时限流按 SPEC §10.7 fail-open）----
REDIS_URL=redis://localhost:6379/0

# ---- JWT（SPEC §4.3：access 15min / refresh 7d / rotation）----
# 开发默认值仅用于本地，生产必须通过密钥管理注入且长度 >= 32
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ---- 凭据加密 KEK（AC-15：包裹每租户 DEK 的平台主密钥，base64 32 字节）----
# 生成方式：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_KEK=

# ---- 限流（SPEC §4.5 G2：单域名>=2s、单租户<=20rpm、全局<=200rpm；登录等敏感端点 10rpm）----
RATE_LIMIT_ENABLED=true

# ---- 出网抓取 UA（SPEC §4.5 G3：不伪装浏览器）----
CRAWLER_USER_AGENT=OPCAgentAI/1.0 (+https://opcagentai.com/bot; contact=ops@opcagentai.com)

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_JSON=false
