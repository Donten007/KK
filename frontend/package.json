{
  "name": "evowork-web",
  "version": "0.1.0",
  "private": true,
  "description": "EvoWork — AI 员工 SaaS 控制台前端",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
